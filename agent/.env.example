# Copy this file to .env on each monitored PC. Never commit .env.

# Homelab server URL
SERVER_URL=http://localhost:4000

# One-time token shown in the dashboard when you add this device (M2)
AGENT_TOKEN=

# How often to send metrics, in milliseconds
METRICS_INTERVAL_MS=5000

# Remote commands from the dashboard (lock, restart, shutdown, cancel shutdown).
# off by default. Set to "on" only on PCs you want to control remotely.
REMOTE_COMMANDS=off

# true = log what would run instead of running it (for testing). Default false.
REMOTE_COMMANDS_DRY_RUN=false

# Developer Workspace (projects, Docker, services, ports, logs).
# Path to this PC's project list. Default: workspace.json in the agent folder.
# Copy workspace.example.json to workspace.json and edit it.
WORKSPACE_FILE=
# Start / stop / restart and log viewing from the dashboard. off by default.
# Status and ports are always reported.
WORKSPACE_CONTROL=off

# Multi-Link (use Wi-Fi, Ethernet, and phone USB tethering together). off by default.
# When on, a local proxy runs on this PC (127.0.0.1 only). Point your browser or
# download manager at it to spread connections over all working internet lines.
MULTILINK=off
MULTILINK_HTTP_PORT=8080
MULTILINK_SOCKS_PORT=1080
