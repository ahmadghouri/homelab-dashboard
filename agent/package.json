{
  "name": "homelab-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext js,json --exec \"node --env-file-if-exists=.env src/index.js\"",
    "start": "node --env-file-if-exists=.env src/index.js",
    "lint": "oxlint src",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "oxlint": "^1.93.0"
  }
}
