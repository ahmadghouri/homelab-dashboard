# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Local: mongodb://127.0.0.1:27017/homelab
# Atlas: mongodb+srv://<user>:<password>@<cluster>/homelab
MONGODB_URI=mongodb://127.0.0.1:27017/homelab

# Dashboard origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Secret for signing login tokens. At least 32 characters. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional: Telegram bot for phone alerts. Create a bot with @BotFather in Telegram
# and paste its token here. The chat ID is set from the dashboard (Settings).
TELEGRAM_BOT_TOKEN=

# Optional: your own MikroTik router (RouterOS 7 REST API) for per-device usage,
# bandwidth priority, blocking, and WAN status. Leave ROUTER_TYPE=none to turn it off.
# Use only a router you administer. Create a separate router user for the dashboard.
ROUTER_TYPE=none
ROUTER_URL=https://192.168.88.1
ROUTER_USER=
ROUTER_PASSWORD=
# true only if the router uses its default self-signed certificate on your own LAN
ROUTER_TLS_INSECURE=false

# Optional: Drive (M11). Join several Google Drive accounts into one file store.
# Create an OAuth client (type "Web application") in Google Cloud Console, add the
# redirect URI below to its "Authorized redirect URIs", and paste the id and secret here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/storage/google/callback
# Encrypts the Google tokens in the database. At least 32 random characters.
# If empty, a key is derived from JWT_SECRET.
STORAGE_ENCRYPTION_KEY=
# Largest single upload in GB (default 10) and days a deleted file stays in the trash (default 30)
STORAGE_MAX_UPLOAD_GB=10
STORAGE_TRASH_DAYS=30

# Optional: AdGuard Home for network-wide ad and malware domain blocking
ADGUARD_URL=
ADGUARD_USER=
ADGUARD_PASSWORD=
