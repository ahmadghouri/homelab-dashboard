# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Local: mongodb://127.0.0.1:27017/homelab
# Atlas: mongodb+srv://<user>:<password>@<cluster>/homelab
MONGODB_URI=mongodb://127.0.0.1:27017/homelab

# Dashboard origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Secret for signing login tokens. At least 32 characters. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
