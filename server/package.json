{
  "name": "homelab-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext js,json --exec \"node --env-file-if-exists=.env src/index.js\"",
    "start": "node --env-file-if-exists=.env src/index.js",
    "lint": "oxlint src",
    "test": "node --test",
    "create-admin": "node --env-file-if-exists=.env scripts/createAdmin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "oxlint": "^1.93.0"
  }
}
